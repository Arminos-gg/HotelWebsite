---
// „Ein Tag im Redltal“ – horizontale Reise vom Morgennebel bis zur Sternennacht.
import Photo from './Photo.astro';
import { makeRidge, ridgePath, forest, stars } from '../lib/landscape';

const moments = [
  {
    time: '07:00',
    title: 'Guten Morgen, Redltal',
    text: 'Der Nebel liegt noch in den Wiesen, drinnen duftet es nach Kaffee. Der Tag beginnt mit einem Frühstück aus der Region.',
    photo: 'tag-fruehstueck',
    illu: 'teller',
  },
  {
    time: '09:00',
    title: 'Köpfe frei für Neues',
    text: 'Im Seminarraum mit Tageslicht und zeitgemäßer Technik beginnt der Arbeitstag – konzentriert, aber nie eng.',
    photo: 'seminar-gross',
    illu: 'seminar',
  },
  {
    time: '12:30',
    title: 'Mittag in der Gaststube',
    text: 'Regionale Klassiker und internationale Spezialitäten, frisch zubereitet. Danach ein Kaffee auf der Pausenterrasse.',
    photo: 'gaststube',
    illu: 'stube',
  },
  {
    time: '15:00',
    title: 'Waldpause',
    text: 'Ein paar Schritte vor die Tür und Sie sind mitten im Grün. Die Wälder von Hausruck und Kobernaußerwald liegen gleich ums Eck.',
    photo: 'waldweg',
    illu: 'weg',
  },
  {
    time: '18:00',
    title: 'Wärme, Wasser, Ruhe',
    text: 'Sauna, Dampfbad, Infrarotkabine, Kneippbereich und Hallenbad – für Hausgäste inklusive.',
    photo: 'sauna',
    illu: 'sauna',
  },
  {
    time: '21:30',
    title: 'Stille über dem Tal',
    text: 'Die Fenster des Hofs leuchten, über dem Wald ziehen die Sterne auf. Gute Nacht.',
    photo: 'zimmer-doppel',
    illu: 'zimmer',
  },
];

const ridge = makeRidge(88, 820, [
  [20, 0.004],
  [8, 0.012],
]);
const treeline = ridgePath(ridge, 20) + forest(ridge, 89, { spacing: [10, 22], height: [30, 90], sink: 6 });
const starList = stars(90, 90, 600);
---

<section class="day" data-hscroll aria-labelledby="day-title">
  <div class="day__sticky">
    <div class="day__sky" aria-hidden="true">
      <svg class="day__stars" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
        {starList.map((s) => <circle cx={s.x} cy={s.y} r={s.r} />)}
      </svg>
      <span class="day__sun"></span>
      <span class="day__moon"></span>
      <svg class="day__trees" viewBox="0 700 1600 200" preserveAspectRatio="xMidYMax slice">
        <path d={treeline}></path>
      </svg>
    </div>

    <div class="day__head container">
      <div>
        <p class="eyebrow">Ein Tag im Redltalhof</p>
        <h2 id="day-title" data-split>Vom Morgennebel <em>bis zur Sternennacht.</em></h2>
      </div>
      <div class="day__progress" aria-hidden="true"><span></span></div>
    </div>

    <div class="day__viewport" data-hscroll-viewport tabindex="0" aria-label="Tagesablauf, horizontal scrollbar">
      <ol class="day__track" data-hscroll-track>
        {
          moments.map((m, i) => (
            <li class="day__card">
              <div class="day__time num">{m.time}</div>
              <div class="frame day__img">
                <Photo name={m.photo} illustration={m.illu} alt={m.title} sizes="(min-width: 900px) 32vw, 80vw" />
              </div>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
              <span class="day__idx">
                {String(i + 1).padStart(2, '0')} / {String(moments.length).padStart(2, '0')}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .day {
    --p: 0;
    position: relative;
    color: var(--linen);
    background: var(--forest-900);
  }
  .day__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 3vh, 2.5rem);
    padding-block: calc(var(--header-h) * 0.6) 2rem;
  }
  .day__sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(90deg, #b87a60 0%, #4f86ad 25%, #3f7ea6 42%, #c8924a 62%, #7a3f5c 80%, #0b1626 100%);
    background-size: 600% 100%;
    background-position: calc(var(--p) * 100%) 0;
  }
  .day__sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.25), transparent 40%, rgb(0 0 0 / 0.2));
  }
  .day__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #fff;
    opacity: calc(var(--p) * 3 - 2);
  }
  .day__sun,
  .day__moon {
    position: absolute;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    left: calc(4% + var(--p) * 86%);
    top: calc(64% - sin(var(--p) * 180deg) * 46%);
  }
  .day__sun {
    background: radial-gradient(circle, #fff5d6 0 30%, rgb(255 214 140 / 0.5) 34%, transparent 70%);
    box-shadow: 0 0 120px 40px rgb(255 200 120 / 0.35);
    opacity: calc(1.2 - var(--p) * 1.3);
  }
  .day__moon {
    width: 56px;
    height: 56px;
    left: calc(10% + var(--p) * 76%);
    top: 16%;
    background: radial-gradient(circle at 60% 40%, #f5ecd8 0 55%, transparent 57%);
    box-shadow: 0 0 60px 10px rgb(220 230 255 / 0.2);
    opacity: calc(var(--p) * 4 - 3);
  }
  .day__trees {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 22vh;
    fill: var(--forest-900);
  }

  .day__head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .day__head h2 {
    font-size: clamp(2rem, 4.4vw, 4rem);
    max-width: 16ch;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }
  .day__head h2 em {
    color: var(--amber-2);
  }
  .day__head .eyebrow {
    color: var(--linen);
  }
  .day__progress {
    width: min(260px, 40vw);
    height: 2px;
    background: rgb(255 255 255 / 0.25);
    border-radius: 2px;
    overflow: hidden;
  }
  .day__progress span {
    display: block;
    height: 100%;
    background: var(--amber-2);
    transform-origin: left;
    transform: scaleX(var(--p));
  }

  .day__viewport {
    position: relative;
    z-index: 1;
  }
  .day__track {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    width: max-content;
    will-change: transform;
  }
  @media (min-width: 1400px) {
    .day__track {
      padding-left: calc((100vw - var(--max)) / 2);
      padding-right: 8vw;
    }
  }
  .day__card {
    position: relative;
    width: clamp(280px, 30vw, 440px);
    padding: 1.1rem 1.1rem 1.4rem;
    border-radius: var(--radius-lg);
    background: rgb(12 19 15 / 0.62);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgb(255 255 255 / 0.1);
  }
  .day__time {
    position: absolute;
    top: -0.2rem;
    right: 1.2rem;
    z-index: 2;
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    font-weight: 300;
    line-height: 1;
    color: var(--amber-2);
    transform: translateY(-40%);
    text-shadow: 0 4px 24px rgb(0 0 0 / 0.4);
  }
  .day__img {
    aspect-ratio: 4 / 3;
    height: auto;
    max-height: 34vh;
    width: 100%;
    border-radius: calc(var(--radius-lg) - 0.6rem);
    margin-bottom: 1.2rem;
  }
  .day__card h3 {
    margin-bottom: 0.6rem;
  }
  .day__card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-inv-soft);
    margin: 0;
    padding-right: 1rem;
  }
  .day__idx {
    display: block;
    margin-top: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--amber-2);
    font-weight: 700;
  }

  @media (max-width: 899px) {
    .day__sticky {
      position: relative;
      height: auto;
      padding-block: 5rem 4rem;
    }
    .day__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-block: 1.5rem 1rem;
    }
    .day__viewport::-webkit-scrollbar {
      display: none;
    }
    .day__card {
      width: 82vw;
      scroll-snap-align: center;
    }
    .day__img {
      max-height: none;
    }
  }
</style>
