---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
import { url, isActive } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="site-header" data-header-el>
  <div class="site-header__inner">
    <a class="brand" href={url('/')} aria-label="Redltalhof – Startseite">
      <Logo size={40} />
      <span class="brand__text">
        <span class="brand__name">Redltalhof</span>
        <span class="brand__sub">Redleiten · Hausruck</span>
      </span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, url(item.href)) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="header-phone" href={site.phoneHref}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2" stroke-linejoin="round"></path></svg>
        <span>{site.phone}</span>
      </a>
      <a class="btn btn--sm" href={url('/kontakt/#anfrage')}>Anfragen</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Menü öffnen</span>
        <span class="burger__lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__bg" aria-hidden="true"></div>
  <div class="menu__inner container">
    <nav aria-label="Menü">
      <ol class="menu__list">
        <li style="--i:0">
          <a href={url('/')}>
            <span class="menu__num">00</span>
            <span class="menu__label">Start</span>
            <span class="menu__kicker">Willkommen im Redltal</span>
          </a>
        </li>
        {
          nav.map((item, i) => (
            <li style={`--i:${i + 1}`}>
              <a href={url(item.href)} aria-current={isActive(current, url(item.href)) ? 'page' : undefined}>
                <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu__label">{item.label}</span>
                <span class="menu__kicker">{item.kicker}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu__foot">
      <p>
        {site.address.street}<br />{site.address.zip} {site.address.city}
      </p>
      <p>
        <a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--linen);
    transition:
      transform 0.6s var(--ease),
      background-color 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--forest-900) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    border-bottom: 1px solid var(--line-inv);
  }
  :global(body[data-header='solid']) .site-header::before,
  :global(.is-scrolled) .site-header::before {
    opacity: 1;
  }
  :global(body[data-header='solid']) .site-header::before {
    background: var(--forest-900);
  }
  :global(.is-hidden) .site-header {
    transform: translateY(-100%);
  }
  :global(.menu-open) .site-header {
    transform: none;
  }
  :global(.menu-open) .site-header::before {
    opacity: 0;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
    padding-inline: var(--gutter);
    max-width: 1720px;
    margin-inline: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: inherit;
  }
  .brand svg {
    color: var(--amber-2);
    transition: transform 0.8s var(--ease);
  }
  .brand:hover svg {
    transform: rotate(-8deg) scale(1.05);
  }
  .brand__text {
    display: grid;
    line-height: 1;
  }
  .brand__name {
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    font-variation-settings: 'SOFT' 100;
  }
  .brand__sub {
    margin-top: 0.3rem;
    font-size: 0.62rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    opacity: 0.7;
    font-weight: 600;
  }

  .nav ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    position: relative;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    padding-block: 0.5rem;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--amber);
    transform: scale(0);
    transition: transform 0.4s var(--ease);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scale(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    opacity: 0.9;
  }
  .btn--sm {
    padding: 0.7rem 1.25rem;
    font-size: 0.85rem;
  }

  .burger {
    display: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-inv);
    background: transparent;
    cursor: pointer;
    place-items: center;
  }
  .burger__lines {
    display: grid;
    gap: 6px;
    width: 20px;
  }
  .burger__lines i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  .burger[aria-expanded='true'] .burger__lines i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__lines i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (max-width: 1080px) {
    .nav,
    .header-phone {
      display: none;
    }
    .burger {
      display: grid;
    }
  }
  @media (max-width: 520px) {
    .site-header__actions .btn {
      display: none;
    }
    .brand__name {
      font-size: 1.35rem;
    }
  }

  /* Vollbild-Menü */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    color: var(--linen);
    overflow-y: auto;
  }
  .menu[hidden] {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }
  .menu__bg {
    position: fixed;
    inset: 0;
    background: var(--forest-950);
    clip-path: circle(0% at calc(100% - 3rem) 2.6rem);
    transition: clip-path 0.9s var(--ease-in-out);
  }
  :global(.menu-open) .menu__bg {
    clip-path: circle(150% at calc(100% - 3rem) 2.6rem);
  }
  .menu__inner {
    position: relative;
    min-height: 100%;
    display: grid;
    align-content: center;
    gap: 3rem;
    padding-block: calc(var(--header-h) + 2rem) 3rem;
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .menu__list li {
    border-bottom: 1px solid var(--line-inv);
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.8s var(--ease);
  }
  :global(.menu-open) .menu__list li {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.25s + var(--i) * 0.06s);
  }
  .menu__list a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    gap: 0 1rem;
    padding-block: 0.9rem;
    text-decoration: none;
  }
  .menu__num {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--amber);
    font-weight: 700;
  }
  .menu__label {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 7vw, 4.2rem);
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.03em;
    transition:
      color 0.4s var(--ease),
      transform 0.6s var(--ease);
  }
  .menu__kicker {
    grid-column: 2;
    font-size: 0.85rem;
    color: var(--text-inv-soft);
  }
  .menu__list a:hover .menu__label,
  .menu__list a[aria-current='page'] .menu__label {
    color: var(--amber-2);
    transform: translateX(10px);
    font-style: italic;
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 4rem;
    font-size: 0.95rem;
    color: var(--text-inv-soft);
    opacity: 0;
    transition: opacity 0.6s var(--ease) 0.6s;
  }
  :global(.menu-open) .menu__foot {
    opacity: 1;
  }
  .menu__foot a {
    text-decoration: none;
    color: var(--linen);
  }
</style>
